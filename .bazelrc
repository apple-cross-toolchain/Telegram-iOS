startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

build --action_env=ZERO_AR_DATE=1

build --enable_platform_specific_config

# Download dependencies directly if the remote downloader configured by --cacheHost fails.
build --experimental_remote_downloader_local_fallback

# Keeps $(TARGET_CPU) as "ios_sim_arm64" rather than "aarch64". Removing this does not
# fail the build: the third-party genrules silently pick the wrong build directory.
build --noincompatible_target_cpu_from_platform

# macOS-specific settings (auto-applied on macOS via --enable_platform_specific_config)
build:macos --features=debug_prefix_map_pwd_is_dot
build:macos --features=swift.cacheable_swiftmodules
build:macos --features=swift.debug_prefix_map
build:macos --features=swift.enable_vfsoverlays
build:dbg --features=swift.emit_swiftsourceinfo

# Linux-specific settings (auto-applied on Linux via --enable_platform_specific_config)
build:linux --action_env=CC
build:linux --action_env=CXX

build --strategy=Genrule=standalone
build --spawn_strategy=standalone

build:macos --strategy=SwiftCompile=worker

common:macos --features=swift.use_global_module_cache
common:macos --features=oso_prefix_is_pwd

common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_DO_NOT_DETECT_SWIFT_TOOLCHAIN=1
build --xcode_version_config=@apple_cross_toolchain//:host_xcodes
build --@build_bazel_rules_apple//apple:sdk_tool_files=@apple_cross_toolchain//:sdk_tool_files
build --action_env=DEVELOPER_DIR=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer
build --action_env=PATH=external/rules_applecross++apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/bin:/usr/bin:/usr/local/bin
build --features=disable_legacy_signing
build --copt=-Wno-reorder-init-list
build --copt=-Wno-deprecated-declarations
build --copt=-Wno-enum-enum-conversion
build --copt=-Wno-misleading-indentation
build --copt=-Wno-enum-float-conversion
build --copt=-Wno-module-import-in-extern-c
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

common:remote --bes_backend=grpcs://app.buildbuddy.io
common:remote --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote --remote_executor=grpcs://app.buildbuddy.io
common:remote --remote_cache_compression
common:remote --remote_timeout=3600
build:remote --jobs=200
build:remote --extra_execution_platforms=//build-system/platforms:linux_x86_64
build:remote --spawn_strategy=remote,local
build:remote --strategy=Genrule=remote,local
build:remote --strategy=SwiftCompile=remote,local
build:remote --remote_download_toplevel
build:remote --@rules_python//python/config_settings:bootstrap_impl=script
